{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "In-seat cinema concession order sent from Customer App to Canteen Receiver App.",
      "type": "object",
      "properties": {
        "orderCode": {
          "type": "string",
          "description": "Display order code starting with ORD- (e.g. ORD-4821)",
          "minLength": 5,
          "maxLength": 16,
          "pattern": "^ORD-[0-9]{4}$"
        },
        "seat": {
          "type": "string",
          "description": "Alphanumeric/hyphen cinema seat code (1-16 chars, e.g. F-12 or 12)",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "hall": {
          "type": "string",
          "description": "Cinema hall / screen label",
          "minLength": 1,
          "maxLength": 48
        },
        "items": {
          "type": "array",
          "description": "Bounded list (1-20 items) with { name, qty, price }"
        },
        "paymentType": {
          "type": "string",
          "description": "Selected payment method",
          "enum": ["digital", "cash"]
        },
        "totalAmount": {
          "type": "number",
          "description": "Numeric order total (0 - 100000)"
        },
        "status": {
          "type": "string",
          "description": "Order fulfillment status ('new' on creation)",
          "enum": ["new", "preparing", "delivered", "cancelled"]
        },
        "source": {
          "type": "string",
          "description": "Origin source identifier",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when order was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when order was last updated"
        }
      },
      "required": [
        "orderCode",
        "seat",
        "hall",
        "items",
        "paymentType",
        "totalAmount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Shared cinema orders collection in ai-studio-lalbandicinemaki-53df80ea-0bab-4f2c-a1a4-e67fee2366ed."
    }
  }
}
